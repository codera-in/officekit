{
  "name": "officekit",
  "version": "1.0.123",
  "description": "OfficeKit - The Private All-in-One Office & Financial Toolkit for Mac, Windows & Linux (Tauri 2)",
  "author": "OfficeKit Team",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/build-desktop.mjs",
    "build:ui": "node scripts/build-ui-assets.mjs && node scripts/build-ui.mjs",
    "icons:build": "node scripts/build-app-icons.mjs",
    "build:sidecar": "node scripts/build-backend-sidecar.mjs",
    "build:sidecar:dry-run": "node scripts/build-backend-sidecar.mjs --dry-run",
    "tauri": "tauri",
    "start:python": "python3 desktop_main.py",
    "test": "npm run build:ui && node --test && node scripts/run-macos-dictation-hotkey-tests.mjs && node scripts/run-macos-global-tests.mjs && node scripts/run-python-tests.mjs",
    "test:process-manager:coverage": "node scripts/check-process-manager-coverage.mjs",
    "test:invoices:coverage": "node scripts/check-invoice-coverage.mjs",
    "test:sidecar": "node scripts/smoke-backend-sidecar.mjs",
    "measure:backend-memory": "node scripts/measure-backend-memory.mjs",
    "measure:speech-memory": "node scripts/measure-speech-model-memory.mjs",
    "test:sidecar:pdf-text": "node scripts/smoke-backend-sidecar.mjs --only-pdf-text",
    "test:sidecar:weak-vector": "node scripts/smoke-backend-sidecar.mjs --only-weak-vector-statement",
    "test:sidecar:similar-images": "node scripts/smoke-backend-sidecar.mjs --only-similar-images",
    "test:macos-hotkey": "node scripts/run-macos-dictation-hotkey-tests.mjs",
    "test:macos-global": "node scripts/run-macos-global-tests.mjs",
    "test:coach-model": "node scripts/run-macos-speech-coach-tests.mjs",
    "test:macos-dmg": "node scripts/smoke-macos-dmg.mjs",
    "test:parakeet-runtime": "node scripts/run-parakeet-runtime-check.mjs",
    "test:qwen3-runtime": "node scripts/run-qwen3-runtime-check.mjs",
    "test:ui": "npm run build:ui && node scripts/ui-browser-preflight.mjs && playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/cli": "4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "7zip-bin-full": "26.6.0",
    "c8": "^12.0.0",
    "daisyui": "5.8.2",
    "tailwindcss": "4.3.5"
  }
}
