				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>set -euo pipefail
app_path=$(/usr/bin/osascript -e 'POSIX path of (path to application id "app.officekit.desktop")' 2&gt;/dev/null) || app_path=
if [[ -z "$app_path" ]]; then
  /usr/bin/osascript -e 'display alert "OfficeKit is not installed" message "Install or move OfficeKit to Applications, then try again."'
  exit 1
fi
cli="${app_path}Contents/Resources/binaries/officekit-media"
if [[ ! -x "$cli" ]]; then
  /usr/bin/osascript -e 'display alert "OfficeKit media tools are unavailable"'
  exit 1
fi
if (( $# &gt; 30 )); then
  /usr/bin/osascript -e 'display alert "Choose 30 images or fewer"'
  exit 1
fi
for file in "$@"; do
  [[ -f "$file" &amp;&amp; ! -L "$file" ]] || continue
  "$cli" --preset optimize-image --collision-policy suffix --output-dir "${file:h}" "$file"
done</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
