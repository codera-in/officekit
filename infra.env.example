# infra.env.example — copy to infra.env and fill in. infra.env is GITIGNORED:
# it holds real credentials/endpoints for /se-debug and the devops persona.
# Commit THIS example (placeholders only); never commit infra.env itself.
#
# LOG_SOURCE per environment: local-cmd | cloudwatch | sentry | ssh | file | mcp:<name>
# Only fill the environments and providers this repo actually has.

# ---- local ----------------------------------------------------------------
LOCAL_API_URL=http://localhost:3000
LOCAL_LOG_SOURCE=local-cmd
LOCAL_LOG_CMD="docker compose logs -f api"        # or: tail -f .logs/dev.log

# ---- qa -------------------------------------------------------------------
QA_API_URL=
QA_LOG_SOURCE=cloudwatch
QA_AWS_PROFILE=                                    # aws cli profile with READ-ONLY logs access
QA_LOG_GROUP=                                      # e.g. /aws/lambda/<app>-qa-api

# ---- production -----------------------------------------------------------
PROD_API_URL=
PROD_LOG_SOURCE=cloudwatch
PROD_AWS_PROFILE=                                  # READ-ONLY profile; never admin creds here
PROD_LOG_GROUP=

# ---- providers (optional) -------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY auth: prefer the Sentry MCP (claude mcp add) over a raw token here.

# ---- ssh log sources (only if LOG_SOURCE=ssh) -----------------------------
# QA_SSH_HOST=user@host   QA_SSH_LOG_PATH=/var/log/app/api.log
